#!/bin/bash

BASE_URL="http://127.0.0.1:5000/api/v1/users"

echo
echo "=================================================="
echo "TEST 1 - CREATE USER"
echo "=================================================="
echo "Request:"
echo 'POST /api/v1/users/'
echo '{
  "first_name": "Jane",
  "last_name": "Doe",
  "email": "janedoe2@hotmail.com"
}'
echo
echo "Expected:"
echo "- HTTP 201"
echo "- first_name = Jane"
echo "- last_name = Doe"
echo "- email = janedoe2@hotmail.com"
echo "- an id generated by the server"
echo
echo "Actual response:"

CREATE_RESPONSE=$(curl -s -w "\nHTTP_STATUS:%{http_code}" \
  -X POST "$BASE_URL/" \
  -H "Content-Type: application/json" \
  -d '{
    "first_name": "Jane",
    "last_name": "Doe",
    "email": "janedoe2@hotmail.com"
  }')

echo "$CREATE_RESPONSE"

CREATE_BODY=$(echo "$CREATE_RESPONSE" | sed '/HTTP_STATUS:/d')

USER_ID=$(echo "$CREATE_BODY" | python3 -c \
'import sys, json; print(json.load(sys.stdin)["id"])')

echo
echo "Extracted USER_ID: $USER_ID"


echo
echo "=================================================="
echo "TEST 2 - GET CREATED USER"
echo "=================================================="
echo "Request:"
echo "GET /api/v1/users/$USER_ID"
echo
echo "Expected:"
echo "- HTTP 200"
echo "- id = $USER_ID"
echo "- first_name = Jane"
echo "- last_name = Doe"
echo "- email = janedoe2@hotmail.com"
echo
echo "Actual response:"

curl -s -i \
  -X GET "$BASE_URL/$USER_ID"


echo
echo
echo "=================================================="
echo "TEST 3 - UPDATE USER"
echo "=================================================="
echo "Request:"
echo "PUT /api/v1/users/$USER_ID"
echo '{
  "first_name": "Jane-Annie",
  "last_name": "Doe",
  "email": "janedoe2@hotmail.com"
}'
echo
echo "Expected:"
echo "- HTTP 200"
echo "- the existing user is updated"
echo "- first_name should become Jane-Annie"
echo
echo "Actual response:"

curl -s -i \
  -X PUT "$BASE_URL/$USER_ID" \
  -H "Content-Type: application/json" \
  -d '{
    "first_name": "Jane-Annie",
    "last_name": "Doe",
    "email": "janedoe2@hotmail.com"
  }'


echo
echo
echo "=================================================="
echo "TEST 4 - VERIFY USER AFTER UPDATE"
echo "=================================================="
echo "Request:"
echo "GET /api/v1/users/$USER_ID"
echo
echo "Expected:"
echo "- HTTP 200"
echo "- id = $USER_ID"
echo "- first_name = Jane-Annie"
echo "- last_name = Doe"
echo "- email = janedoe2@hotmail.com"
echo
echo "Actual response:"

curl -s -i \
  -X GET "$BASE_URL/$USER_ID"


echo
echo
echo "=================================================="
echo "TEST 5 - DUPLICATE EMAIL"
echo "=================================================="
echo "Request:"
echo 'POST /api/v1/users/'
echo '{
  "first_name": "Other",
  "last_name": "Person",
  "email": "janedoe2@hotmail.com"
}'
echo
echo "Expected:"
echo "- HTTP 400"
echo "- error indicating that the email already exists"
echo
echo "Actual response:"

curl -s -i \
  -X POST "$BASE_URL/" \
  -H "Content-Type: application/json" \
  -d '{
    "first_name": "Other",
    "last_name": "Person",
    "email": "janedoe2@hotmail.com"
  }'


echo
echo
echo "=================================================="
echo "TEST 6 - GET UNKNOWN USER"
echo "=================================================="
echo "Request:"
echo "GET /api/v1/users/does-not-exist"
echo
echo "Expected:"
echo "- HTTP 404"
echo "- error = User not found"
echo
echo "Actual response:"

curl -s -i \
  -X GET "$BASE_URL/does-not-exist"


echo
echo
echo "=================================================="
echo "END OF TESTS"
echo "=================================================="


