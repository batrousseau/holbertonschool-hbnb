#!/bin/bash

AMENITY_BASE_URL="http://127.0.0.1:5000/api/v1/amenities"
BODY_FILE="/tmp/hbnb_amenity_response.txt"

show_response() {
    local http_code

    http_code=$(curl -s \
        -o "$BODY_FILE" \
        -w "%{http_code}" \
        "$@")

    echo
    echo "HTTP status: $http_code"
    echo "Response body:"

    # Avoid flooding the terminal with Flask HTML error pages
    head -c 1200 "$BODY_FILE"
    echo
    echo

    LAST_HTTP_CODE="$http_code"
}


echo
echo "##################################################"
echo "#                 AMENITIES                      #"
echo "##################################################"


echo
echo "=================================================="
echo "TEST 1 - CREATE AMENITY"
echo "=================================================="
echo "Request:"
echo "POST /api/v1/amenities/"
echo '{
  "name": "Wi-Fi"
}'
echo
echo "Expected:"
echo "- HTTP 201"
echo "- name = Wi-Fi"
echo "- an id generated by the server"
echo
echo "Actual response:"

show_response \
    -X POST "$AMENITY_BASE_URL/" \
    -H "Content-Type: application/json" \
    -d '{
        "name": "Wi-Fi"
    }'


echo "Extracting amenity ID..."

AMENITY_ID=$(python3 -c '
import sys, json

try:
    with open("/tmp/hbnb_amenity_response.txt") as f:
        data = json.load(f)
    print(data.get("id", ""))
except Exception:
    print("")
')

echo "Extracted AMENITY_ID: $AMENITY_ID"

if [ -z "$AMENITY_ID" ]; then
    echo
    echo "ERROR: AMENITY_ID could not be extracted."
    echo "Stopping tests because following routes require an amenity ID."
    exit 1
fi


echo
echo "=================================================="
echo "TEST 2 - GET ALL AMENITIES"
echo "=================================================="
echo "Request:"
echo "GET /api/v1/amenities/"
echo
echo "Expected:"
echo "- HTTP 200"
echo "- list contains Wi-Fi"
echo
echo "Actual response:"

show_response \
    -X GET "$AMENITY_BASE_URL/"


echo
echo "=================================================="
echo "TEST 3 - GET CREATED AMENITY"
echo "=================================================="
echo "Request:"
echo "GET /api/v1/amenities/$AMENITY_ID"
echo
echo "Expected:"
echo "- HTTP 200"
echo "- id = $AMENITY_ID"
echo "- name = Wi-Fi"
echo
echo "Actual response:"

show_response \
    -X GET "$AMENITY_BASE_URL/$AMENITY_ID"


echo
echo "=================================================="
echo "TEST 4 - UPDATE AMENITY"
echo "=================================================="
echo "Request:"
echo "PUT /api/v1/amenities/$AMENITY_ID"
echo '{
  "name": "High-speed Wi-Fi"
}'
echo
echo "Expected:"
echo "- HTTP 200"
echo "- same amenity id"
echo "- name becomes High-speed Wi-Fi"
echo
echo "Actual response:"

show_response \
    -X PUT "$AMENITY_BASE_URL/$AMENITY_ID" \
    -H "Content-Type: application/json" \
    -d '{
        "name": "High-speed Wi-Fi"
    }'


echo
echo "=================================================="
echo "TEST 5 - VERIFY AMENITY AFTER UPDATE"
echo "=================================================="
echo "Request:"
echo "GET /api/v1/amenities/$AMENITY_ID"
echo
echo "Expected:"
echo "- HTTP 200"
echo "- id = $AMENITY_ID"
echo "- name = High-speed Wi-Fi"
echo
echo "Actual response:"

show_response \
    -X GET "$AMENITY_BASE_URL/$AMENITY_ID"


echo
echo "=================================================="
echo "TEST 6 - INVALID AMENITY PAYLOAD"
echo "=================================================="
echo "Request:"
echo "POST /api/v1/amenities/"
echo '{}'
echo
echo "Expected:"
echo "- HTTP 400"
echo "- RESTX validation error because name is required"
echo
echo "Actual response:"

show_response \
    -X POST "$AMENITY_BASE_URL/" \
    -H "Content-Type: application/json" \
    -d '{}'


echo
echo "=================================================="
echo "TEST 7 - UNKNOWN AMENITY"
echo "=================================================="
echo "Request:"
echo "GET /api/v1/amenities/does-not-exist"
echo
echo "Expected:"
echo "- HTTP 404"
echo "- error = Amenity not found"
echo
echo "Actual response:"

show_response \
    -X GET "$AMENITY_BASE_URL/does-not-exist"


echo
echo "=================================================="
echo "END OF AMENITY TESTS"
echo "=================================================="